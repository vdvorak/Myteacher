{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "assessed",
          "title": "Status",
          "type": "string"
        },
        "exercise_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Exercise Id",
          "type": "string"
        },
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "correct": {
          "title": "Correct",
          "type": "boolean"
        },
        "solution": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultipleChoiceSolution"
            },
            {
              "type": "null"
            }
          ],
          "description": "Withheld (null) for a wrong answer the student may still retry."
        }
      },
      "required": [
        "status",
        "exercise_id",
        "score",
        "correct",
        "solution"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "AssessmentUnavailable": {
      "additionalProperties": false,
      "description": "The answer fits the exercise, but its type has no assessor in this phase.",
      "properties": {
        "status": {
          "const": "unavailable",
          "title": "Status",
          "type": "string"
        },
        "exercise_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Exercise Id",
          "type": "string"
        },
        "reason": {
          "const": "no_assessor_in_this_phase",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "exercise_id",
        "reason"
      ],
      "title": "AssessmentUnavailable",
      "type": "object"
    },
    "AttachmentReference": {
      "additionalProperties": false,
      "description": "A file stored with the course (attachment storage arrives in slice 3).",
      "properties": {
        "attachment_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Attachment Id",
          "type": "string"
        }
      },
      "required": [
        "attachment_id"
      ],
      "title": "AttachmentReference",
      "type": "object"
    },
    "BlankCell": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "blank",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "accepted_answers": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Accepted Answers",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "accepted_answers"
      ],
      "title": "BlankCell",
      "type": "object"
    },
    "BlankCellPublic": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "blank",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "BlankCellPublic",
      "type": "object"
    },
    "ChoiceOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "ChoiceOption",
      "type": "object"
    },
    "CustomAnswer": {
      "additionalProperties": false,
      "description": "Opaque JSON from a custom exercise frame, validated only for size.",
      "properties": {
        "type": {
          "const": "custom",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "CustomAnswer",
      "type": "object"
    },
    "CustomExercise": {
      "additionalProperties": false,
      "description": "Assistant-written HTML run in a sandbox with a fixed result contract (ADR 0006).",
      "properties": {
        "type": {
          "const": "custom",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt"
        },
        "html": {
          "maxLength": 200000,
          "minLength": 1,
          "title": "Html",
          "type": "string"
        },
        "specification": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Specification",
          "type": "string"
        },
        "example": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "assessment_mode": {
          "description": "self_assessed_advisory: the frame reports a self-assessment the teacher confirms. teacher_assessed: the teacher assesses the answer.",
          "enum": [
            "self_assessed_advisory",
            "teacher_assessed"
          ],
          "title": "Assessment Mode",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "html",
        "specification",
        "example",
        "assessment_mode"
      ],
      "title": "CustomExercise",
      "type": "object"
    },
    "CustomExercisePublic": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "custom",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt"
        },
        "html": {
          "title": "Html",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "html"
      ],
      "title": "CustomExercisePublic",
      "type": "object"
    },
    "ExplanationBlock": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "explanation",
          "title": "Type",
          "type": "string"
        },
        "markdown": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        }
      },
      "required": [
        "type",
        "markdown"
      ],
      "title": "ExplanationBlock",
      "type": "object"
    },
    "FieldError": {
      "properties": {
        "loc": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Loc",
          "type": "array"
        },
        "msg": {
          "title": "Msg",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "loc",
        "msg",
        "type"
      ],
      "title": "FieldError",
      "type": "object"
    },
    "GivenCell": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "given",
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "GivenCell",
      "type": "object"
    },
    "JsonValue": {},
    "LessonDocument": {
      "additionalProperties": false,
      "description": "A lesson as stored and authored: canonical, unshuffled, with its answer key.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "feedback_mode": {
          "description": "immediate: each closed answer is assessed at once, with one retry and a hint after a wrong answer. at_the_end: nothing is assessed until the lesson is submitted.",
          "enum": [
            "immediate",
            "at_the_end"
          ],
          "title": "Feedback Mode",
          "type": "string"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "custom": "#/$defs/CustomExercise",
                "explanation": "#/$defs/ExplanationBlock",
                "listening": "#/$defs/ListeningExercise",
                "multiple_choice": "#/$defs/MultipleChoiceExercise",
                "numeric": "#/$defs/NumericExercise",
                "span_highlight": "#/$defs/SpanHighlightExercise",
                "table_fill": "#/$defs/TableFillExercise"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExplanationBlock"
              },
              {
                "$ref": "#/$defs/MultipleChoiceExercise"
              },
              {
                "$ref": "#/$defs/SpanHighlightExercise"
              },
              {
                "$ref": "#/$defs/TableFillExercise"
              },
              {
                "$ref": "#/$defs/NumericExercise"
              },
              {
                "$ref": "#/$defs/ListeningExercise"
              },
              {
                "$ref": "#/$defs/CustomExercise"
              }
            ]
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "feedback_mode",
        "blocks"
      ],
      "title": "LessonDocument",
      "type": "object"
    },
    "LessonPublic": {
      "additionalProperties": false,
      "description": "A lesson as the browser receives it: no answer key, no solutions.",
      "properties": {
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "language": {
          "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "feedback_mode": {
          "description": "immediate: each closed answer is assessed at once, with one retry and a hint after a wrong answer. at_the_end: nothing is assessed until the lesson is submitted.",
          "enum": [
            "immediate",
            "at_the_end"
          ],
          "title": "Feedback Mode",
          "type": "string"
        },
        "blocks": {
          "items": {
            "discriminator": {
              "mapping": {
                "custom": "#/$defs/CustomExercisePublic",
                "explanation": "#/$defs/ExplanationBlock",
                "listening": "#/$defs/ListeningExercisePublic",
                "multiple_choice": "#/$defs/MultipleChoiceExercisePublic",
                "numeric": "#/$defs/NumericExercisePublic",
                "span_highlight": "#/$defs/SpanHighlightExercisePublic",
                "table_fill": "#/$defs/TableFillExercisePublic"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ExplanationBlock"
              },
              {
                "$ref": "#/$defs/MultipleChoiceExercisePublic"
              },
              {
                "$ref": "#/$defs/SpanHighlightExercisePublic"
              },
              {
                "$ref": "#/$defs/TableFillExercisePublic"
              },
              {
                "$ref": "#/$defs/NumericExercisePublic"
              },
              {
                "$ref": "#/$defs/ListeningExercisePublic"
              },
              {
                "$ref": "#/$defs/CustomExercisePublic"
              }
            ]
          },
          "title": "Blocks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "feedback_mode",
        "blocks"
      ],
      "title": "LessonPublic",
      "type": "object"
    },
    "ListeningAnswer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "listening",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "ListeningAnswer",
      "type": "object"
    },
    "ListeningExercise": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "listening",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "audio": {
          "$ref": "#/$defs/AttachmentReference"
        },
        "transcript": {
          "anyOf": [
            {
              "maxLength": 5000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript"
        },
        "accepted_answers": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Accepted Answers",
          "type": "array"
        },
        "hint": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "audio",
        "accepted_answers"
      ],
      "title": "ListeningExercise",
      "type": "object"
    },
    "ListeningExercisePublic": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "listening",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "audio": {
          "$ref": "#/$defs/AttachmentReference"
        },
        "hint": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hint"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "audio",
        "hint"
      ],
      "title": "ListeningExercisePublic",
      "type": "object"
    },
    "MultipleChoiceAnswer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "multiple_choice",
          "title": "Type",
          "type": "string"
        },
        "option_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Option Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "option_id"
      ],
      "title": "MultipleChoiceAnswer",
      "type": "object"
    },
    "MultipleChoiceExercise": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "multiple_choice",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correct_option_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Correct Option Id",
          "type": "string"
        },
        "hint": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "solution_explanation": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Solution Explanation"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "options",
        "correct_option_id"
      ],
      "title": "MultipleChoiceExercise",
      "type": "object"
    },
    "MultipleChoiceExercisePublic": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "multiple_choice",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ChoiceOption"
          },
          "title": "Options",
          "type": "array"
        },
        "hint": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hint"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "options",
        "hint"
      ],
      "title": "MultipleChoiceExercisePublic",
      "type": "object"
    },
    "MultipleChoiceSolution": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "multiple_choice",
          "title": "Type",
          "type": "string"
        },
        "option_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Option Id",
          "type": "string"
        },
        "explanation": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Explanation"
        }
      },
      "required": [
        "type",
        "option_id",
        "explanation"
      ],
      "title": "MultipleChoiceSolution",
      "type": "object"
    },
    "NumericAnswer": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "numeric",
          "title": "Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "type",
        "value"
      ],
      "title": "NumericAnswer",
      "type": "object"
    },
    "NumericExercise": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "numeric",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "description": "Constrained Markdown (CommonMark without raw HTML).",
          "maxLength": 20000,
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "correct_value": {
          "title": "Correct Value",
          "type": "number"
        },
        "tolerance": {
          "default": 0,
          "description": "Largest accepted absolute difference from the value.",
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "hint": {
          "anyOf": [
            {
              "description": "Constrained Markdown (CommonMark without raw HTML).",
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        }
      },
      "required": [
        "type",
        "id",
        "prompt",
        "correct_value"
      ],
      "title": "NumericExercise",
      "type": "object"
    },
    "NumericExercisePublic": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "numeric",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
