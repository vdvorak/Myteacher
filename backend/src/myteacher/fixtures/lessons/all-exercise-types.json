{
  "id": "all-exercise-types",
  "title": "Every exercise type",
  "language": "es",
  "feedback_mode": "immediate",
  "blocks": [
    {
      "type": "explanation",
      "markdown": "A developer fixture holding one exercise of every type in the catalog. Types without a renderer in this phase show a placeholder."
    },
    {
      "type": "multiple_choice",
      "id": "choice",
      "prompt": "¿Dónde ___ la estación?",
      "options": [
        { "id": "es", "text": "es" },
        { "id": "esta", "text": "está" }
      ],
      "correct_option_id": "esta",
      "hint": "Location.",
      "solution_explanation": "Location takes **estar**."
    },
    {
      "type": "span_highlight",
      "id": "highlight",
      "prompt": "Highlight every form of *estar*.",
      "text": "Hoy estoy en casa, pero mañana estaremos en Sevilla.",
      "correct_spans": [
        { "start": 4, "end": 9 },
        { "start": 31, "end": 40 }
      ]
    },
    {
      "type": "table_fill",
      "id": "conjugation",
      "prompt": "Complete the present tense of *estar*.",
      "columns": ["Persona", "Forma"],
      "rows": [
        [{ "kind": "given", "text": "yo" }, { "kind": "blank", "id": "yo", "accepted_answers": ["estoy"] }],
        [{ "kind": "given", "text": "tú" }, { "kind": "blank", "id": "tu", "accepted_answers": ["estás"] }],
        [{ "kind": "given", "text": "nosotros" }, { "kind": "blank", "id": "nosotros", "accepted_answers": ["estamos"] }]
      ]
    },
    {
      "type": "numeric",
      "id": "distance",
      "prompt": "Madrid y Sevilla están a unos ___ km en tren. Estima.",
      "correct_value": 530,
      "tolerance": 30,
      "unit": "km"
    },
    {
      "type": "listening",
      "id": "dictation",
      "prompt": "Listen and write down the sentence.",
      "audio": { "attachment_id": "dictado-01" },
      "transcript": "¿Dónde está la estación de tren?",
      "accepted_answers": ["¿Dónde está la estación de tren?", "Dónde está la estación de tren"]
    },
    {
      "type": "custom",
      "id": "stress",
      "prompt": "Tap the stressed syllable.",
      "html": "<!doctype html><html><body><p>can·ción</p></body></html>",
      "specification": "Shows a word split into syllables; the student taps the stressed one. Correct when the tapped syllable is the stressed one.",
      "example": "can·ción → ción",
      "assessment_mode": "self_assessed_advisory"
    }
  ]
}
