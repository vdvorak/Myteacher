    {
      "type": "explanation",
      "markdown": "Many common English verbs have an irregular past simple: *take → took*, *make → made*, *eat → ate*. They have to be remembered, so they are worth practising.\n\nCheck your answers before you submit."
    },
    {
      "type": "cloze",
      "id": "yesterday",
      "prompt": "Write the past simple of the verb in brackets.",
      "segments": [
        {
          "kind": "text",
          "text": "Yesterday I "
        },
        {
          "kind": "candidate",
          "id": "v1",
          "answer": "went"
        },
        {
          "kind": "text",
          "text": " (go) to the market, "
        },
        {
          "kind": "candidate",
          "id": "v2",
          "answer": "bought"
        },
        {
          "kind": "text",
          "text": " (buy) some apples and "
        },
        {
          "kind": "candidate",
          "id": "v3",
          "answer": "saw"
        },
        {
          "kind": "text",
          "text": " (see) an old friend."
        }
      ],
      "blanked": [
        "v1",
        "v3"
      ],
      "solution_explanation": "*go → **went***, *buy → **bought***, *see → **saw***."
    },
    {
      "type": "short_answer",
      "id": "contraction",
      "prompt": "Write the short form of *do not*.",
      "accepted_answers": [
        "don't",
        "don’t"
      ],
      "solution_explanation": "*Don't*: the apostrophe replaces the *o* of *not*."
    }
